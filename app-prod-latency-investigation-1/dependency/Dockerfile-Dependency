FROM python:3.12-slim

WORKDIR /dependency-app

COPY dependency-requirements.txt .

RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/* \
    && pip install \
       --no-cache-dir \
       --disable-pip-version-check \
       -r dependency-requirements.txt

COPY dependency_app.py .

RUN useradd \
    --create-home \
    --uid 10001 \
    dependency

USER dependency

EXPOSE 8081

CMD ["gunicorn", \
     "--bind", "0.0.0.0:8081", \
     "--workers", "1", \
     "--threads", "4", \
     "--timeout", "30", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "dependency_app:app"]